[]
access = read : [ * ], write : [ admin ]
export = none

[views]
export = system

[collections/so_jobs]
access = read : [ admin ], write : [ admin ]

[collections/so_runs]
access = read : [ admin ], write : [ admin ]

[collections/so_step_runs]
access = read : [ admin ], write : [ admin ]

[collections/so_action_runs]
access = read : [ admin ], write : [ admin ]

[collections/so_commands]
access = read : [ admin ], write : [ admin ]

[collections/so_locks]
access = read : [ admin ], write : [ admin ]

[collections/so_settings]
access = read : [ admin ], write : [ admin ]

# Temporary: Milestone 1 spike results, exported so | inputlookup works from any app. Removed in Task 6.
[collections/so_spike]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system

[transforms/so_spike_results]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system
