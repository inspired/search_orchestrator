{
  "id": "example_top_sourcetypes",
  "name": "Example: top sourcetypes to a lookup",
  "description": "Each night, ranks yesterday's sourcetypes by event count and writes the top 20 to the lookup so_example_top_sourcetypes.csv, replacing it each run.",
  "enabled": false,
  "triggers": [
    {
      "type": "cron",
      "cron": "30 2 * * *"
    }
  ],
  "steps": [
    {
      "id": "top_sourcetypes",
      "name": "Top sourcetypes by events",
      "type": "inline",
      "spl": "| tstats count WHERE index=* BY sourcetype\n| sort - count\n| head 20",
      "earliest": "-1d@d",
      "latest": "@d"
    },
    {
      "id": "save_lookup",
      "name": "Write to lookup",
      "type": "previous",
      "spl": "| outputlookup so_example_top_sourcetypes.csv",
      "output": {
        "kind": "lookup",
        "name": "so_example_top_sourcetypes.csv"
      }
    }
  ],
  "edges": [
    {
      "from": "top_sourcetypes",
      "to": "save_lookup",
      "condition": "on_success"
    }
  ],
  "layout": {
    "nodes": {
      "trigger:0": {
        "x": 40,
        "y": 36
      },
      "job": {
        "x": 20,
        "y": 120
      },
      "step:top_sourcetypes": {
        "x": 320,
        "y": 20
      },
      "step:save_lookup": {
        "x": 600,
        "y": 20
      }
    }
  }
}
