{
  "id": "example_approval",
  "name": "Example: approve before recording",
  "description": "Each weekday morning finds the indexes that used the most license yesterday. An approval step asks an admin to confirm before the run records the top index as an event in main. A rejection, or an hour without an answer, ends the run without writing anything.",
  "enabled": false,
  "tags": [
    "example",
    "notifications"
  ],
  "triggers": [
    {
      "type": "cron",
      "cron": "30 8 * * 1-5"
    }
  ],
  "steps": [
    {
      "id": "usage",
      "name": "License usage by index",
      "type": "inline",
      "spl": "index=_internal source=*license_usage.log* type=Usage\n| stats sum(b) AS bytes BY idx\n| eval gb=round(bytes/1024/1024/1024, 2)\n| sort - gb\n| head 5",
      "earliest": "-1d@d",
      "latest": "@d"
    },
    {
      "id": "confirm",
      "name": "Confirm before recording",
      "type": "approval",
      "approval": {
        "message": "Top index $usage.first.idx$ used $usage.first.gb$ GB yesterday. Record it?",
        "timeout": 3600,
        "on_timeout": "reject",
        "approver_roles": [
          "admin"
        ]
      },
      "actions": [
        {
          "hook": "on_approval_requested",
          "type": "email",
          "to": "you@example.com",
          "subject": "{{job}} needs your approval",
          "message": "{{message}}\n\n{{run_url}}"
        }
      ]
    },
    {
      "id": "record",
      "name": "Record the top index",
      "type": "inline",
      "spl": "| makeresults\n| eval idx=\"$usage.first.idx$\", gb=\"$usage.first.gb$\"",
      "earliest": "-1m",
      "latest": "now",
      "actions": [
        {
          "hook": "on_success",
          "type": "event",
          "index": "main",
          "payload": "{\"source\": \"search_orchestrator\", \"job\": \"{{job}}\", \"top_index\": \"$usage.first.idx$\", \"gb\": \"$usage.first.gb$\"}"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "usage",
      "to": "confirm",
      "condition": "on_success"
    },
    {
      "from": "confirm",
      "to": "record",
      "condition": "on_success"
    }
  ],
  "layout": {
    "nodes": {
      "trigger:0": {
        "x": 40,
        "y": 36
      },
      "job": {
        "x": 20,
        "y": 180
      },
      "step:usage": {
        "x": 320,
        "y": 20
      },
      "step:confirm": {
        "x": 600,
        "y": 20
      },
      "action:confirm:0": {
        "x": 600,
        "y": 150
      },
      "step:record": {
        "x": 880,
        "y": 20
      },
      "action:record:0": {
        "x": 880,
        "y": 150
      }
    }
  }
}
